# Banco (senha fictícia; substitua no .env)
POSTGRES_USER=atto
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=atto
DB_PORT=5432
DATABASE_URL=postgresql://atto:troque-esta-senha@db:5432/atto
# Banco separado, usado apenas nos testes
DATABASE_URL_TEST=postgresql://atto:troque-esta-senha@db:5432/atto_test

# API e sessão (development permite HTTP local)
API_PORT=3030
API_HOST=0.0.0.0
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute

# Seed somente; substitua a senha antes de executar
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha-forte

# Web
WEB_PORT=3000
WEB_HOST=0.0.0.0
API_INTERNAL_URL=http://api:3030

# Atto: usadas na próxima etapa; não há chamadas automáticas
ATTO_ADMIN_URL=https://cloud.attodigital.com/AttoSolution/WebAdmin/Services/AdminService.svc
ATTO_SUPERVISION_URL=https://cloud.attodigital.com/AttoSolution/WebSupervision/Services/SupService.svc
ATTO_LOGIN=
ATTO_PASSWORD=
ATTO_CUSTOMER_SID=
ATTO_TOKEN_TTL_HOURS=23
ATTO_LOGIN_MIN_INTERVAL_MINUTES=60
ATTO_REQUEST_TIMEOUT_MS=15000
ATTO_TOKEN_ENC_KEY=
