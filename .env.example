# Banco — senha fictícia, troque no seu .env
POSTGRES_USER=atto
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=atto
DB_PORT=5432
DATABASE_URL=postgresql://atto:troque-esta-senha@db:5432/atto

# API e sessão
API_PORT=3030
API_HOST=0.0.0.0
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute

# Web
WEB_PORT=3000
WEB_HOST=0.0.0.0
API_INTERNAL_URL=http://api:3030

# Atto — login da web nunca usa e-mail, sempre a conta Atto digitada; o
# primeiro login bem-sucedido vira administrador (sem seed nem usuário de
# exemplo). ATTO_LOGIN/ATTO_PASSWORD são só a conta de serviço do coletor.
ATTO_ADMIN_URL=https://cloud.attodigital.com/AttoSolution/WebAdmin/Services/AdminService.svc
ATTO_SUPERVISION_URL=https://cloud.attodigital.com/AttoSolution/WebSupervision/Services/SupService.svc
ATTO_LOGIN=
ATTO_PASSWORD=
ATTO_CUSTOMER_SID=00000000-0000-0000-0000-000000000000
ATTO_TOKEN_TTL_HOURS=23
ATTO_LOGIN_MIN_INTERVAL_MINUTES=60
ATTO_REQUEST_TIMEOUT_MS=15000
# Gere com: openssl rand -base64 32
ATTO_TOKEN_ENC_KEY=k6ev/jgCdZUFUWO10JlqGPOa1g+2ADxjk9oa3psPvxQ=

# Coletor da Atto
COLLECT_INTERVAL_MINUTES=15
COLLECT_BACKFILL_DAYS=7
COLLECT_CALLS_LOOKBACK_HOURS=24
COLLECT_DELAY_AGENTS_MS=6000
COLLECT_DELAY_OTHERS_MS=6000
COLLECT_DELAY_CALLS_MS=15000
APP_TIMEZONE=America/Sao_Paulo

# Seed opcional (pnpm seed) — cria um usuário local com acesso total, pra
# entrar sem precisar de uma conta Atto real. Nunca roda sozinho.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin1234
